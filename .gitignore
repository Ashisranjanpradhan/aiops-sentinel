# ==============================================================================
# AIOps Sentinel — Git Ignore Specification
# ==============================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets.json

# Python runtime & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
env/
venv/
ENV/

# Node.js & Next.js frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
coverage/
.turbo/
frontend/tsconfig.tsbuildinfo

# Test output and local browser caches
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Databases, backups and Redis dumps
*.sqlite
*.sqlite3
*.db
*.dump
dump.rdb
/backups/
*.sql.gz

# Uploaded codebases and assessment scratch workspaces
/data/assessments/*
!/data/assessments/.gitkeep
/tmp/assessment_*
/data/workspaces/*

# Machine Learning datasets and oversized binary weights
/ml/data/*
!/ml/data/.gitkeep
/ml/artifacts/*.joblib
/ml/artifacts/*.pkl
/ml/artifacts/*.onnx
!/ml/artifacts/.gitkeep

# Application logs
*.log
logs/

# Operating system and IDE configurations
.DS_Store
.AppleDouble
.LSOverride
Icon
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
