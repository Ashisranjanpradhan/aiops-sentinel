APP_ENV=development
APP_NAME=AIOps Sentinel
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database: In local standalone mode, SQLite (sqlite+aiosqlite:///./aiops_sentinel.db) can be used,
# or PostgreSQL (postgresql+asyncpg://aiops:change-me-locally@localhost:5432/aiops_sentinel)
POSTGRES_DB=aiops_sentinel
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./aiops_sentinel.db

REDIS_URL=redis://localhost:6379/0

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

SESSION_SECRET=replace-with-a-long-random-local-secret-32-chars-minimum
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEFAULT_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
DATA_DIR=./ml/data
ARTIFACT_DIR=./ml/artifacts
