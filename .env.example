# ==============================================================================
# AIOps Sentinel — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriately for your environment.
# NEVER commit production credentials or keys to version control.

# Application Environment: 'development', 'test', 'staging', or 'production'
APP_ENV=development
APP_NAME=AIOps Sentinel
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ==============================================================================
# Database Configuration
# ==============================================================================
# In development & test: SQLite is supported by default
# DATABASE_URL=sqlite+aiosqlite:///./aiops_sentinel.db
#
# In staging & production: PostgreSQL with asyncpg is MANDATORY
DATABASE_URL=postgresql+asyncpg://aiops_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/aiops_sentinel

POSTGRES_DB=aiops_sentinel
POSTGRES_USER=aiops_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================================================================
# Background Queue & Redis Cache
# ==============================================================================
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# ==============================================================================
# Observability & Telemetry Endpoints
# ==============================================================================
# In production, DEMO_MODE must be false and live backends must be configured
DEMO_MODE=false
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ==============================================================================
# Security & Authentication Secrets
# ==============================================================================
# SESSION_SECRET must be at least 32 cryptographically random characters in staging/prod
# Generate with: openssl rand -hex 32
SESSION_SECRET=GENERATE_AND_REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET

# Set SESSION_COOKIE_SECURE=true when running behind HTTPS in production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=https://sentinel.company.com,https://app.sentinel.company.com

# Rate Limiting & Account Lockout
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_SECONDS=300

# ==============================================================================
# Storage & Directories
# ==============================================================================
DEFAULT_TIMEZONE=UTC
DATA_DIR=./ml/data
ARTIFACT_DIR=./ml/artifacts
ASSESSMENT_WORKSPACE_DIR=/tmp/aiops_assessments
